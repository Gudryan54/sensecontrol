# ============================================================
# Simulador IoT - variáveis de ambiente (exemplo)
# ============================================================
# Copie para ".env" dentro de iot/simulator/ para rodar o simulador.
# Representa o papel do dispositivo ESP32 real: publica leituras no
# broker MQTT, nos mesmos tópicos que um gateway físico usaria.

MQTT_URL=mqtt://localhost:1883

# IDs dos sensores já cadastrados no banco (o seed de demonstração em
# database/009_demo_data.sql já cria o sensor 1 = água e 2 = energia
# do usuário demo). Ajuste se estiver simulando outro sensor cadastrado
# via POST /sensores.
SENSOR_AGUA_ID=1
SENSOR_ENERGIA_ID=2

# Intervalo entre leituras publicadas, em milissegundos. 5000 (5s) é
# bom para acompanhar visualmente numa demonstração ao vivo; o
# gateway real publicaria com uma frequência definida pelo hardware.
INTERVALO_MS=5000

# MODO=normal (padrão) gera consumo dentro do padrão histórico.
# MODO=anomalia força uma leitura de água constante e elevada, para
# demonstrar a detecção de possível vazamento (Etapa 5). Também pode
# ser definido via variável de ambiente na hora de rodar
# (ex.: "MODO=anomalia npm start"), sem precisar editar o .env.
MODO=normal
