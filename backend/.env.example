# ============================================================
# Backend - variáveis de ambiente (exemplo)
# ============================================================
# Copie para ".env" dentro de backend/ ao rodar a API localmente
# (fora do Docker), enquanto o banco/broker continuam via
# `docker compose up -d` na raiz do projeto.
#
# Por quê um .env separado do da raiz? O .env da raiz é usado pelo
# docker-compose e usa o hostname "db" (nome do serviço na rede
# interna do Docker). Quando o backend roda direto na sua máquina
# (ou no Codespace) fora de um container, ele precisa falar com o
# Postgres pelo endereço "localhost", já que a porta 5432 do
# container é publicada para o host (veja docker-compose.yml).
# As credenciais (usuário/senha) devem ser as mesmas do .env da raiz.

DATABASE_URL=postgresql://sensecontrol_app:troque_esta_senha_antes_de_usar@localhost:5432/sensecontrol

PORT=3000
NODE_ENV=development

# Faixa de valores plausível para uma leitura de sensor (litros ou kWh
# por leitura), usada na validação de POST /leituras (ver seção 9 da
# documentação técnica: "valor dentro de uma faixa plausível").
LEITURA_VALOR_MAXIMO=1000
