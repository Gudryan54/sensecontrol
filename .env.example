# ============================================================
# SenseControl - Variáveis de ambiente (exemplo)
# ============================================================
# Copie este arquivo para ".env" na raiz do projeto e ajuste os valores
# se necessário. O ".env" real NUNCA deve ser commitado (veja .gitignore).
# Os valores abaixo já funcionam "out of the box" com o docker-compose.yml
# para fins de demonstração acadêmica - troque-os antes de qualquer uso
# fora deste contexto.

# ---- Banco de dados (PostgreSQL) ----
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=sensecontrol
POSTGRES_USER=sensecontrol_app
POSTGRES_PASSWORD=troque_esta_senha_antes_de_usar

# String de conexão completa, usada pelo backend
DATABASE_URL=postgresql://sensecontrol_app:troque_esta_senha_antes_de_usar@db:5432/sensecontrol

# ---- Broker MQTT (Mosquitto) ----
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_URL=mqtt://mosquitto:1883

# ---- Backend / API ----
BACKEND_PORT=3000
JWT_SECRET=troque_este_segredo_por_uma_string_aleatoria_longa
JWT_EXPIRES_IN=1h
NODE_ENV=development

# ---- Frontend ----
# URL que o frontend usa para falar com a API (a partir do navegador do usuário)
VITE_API_URL=http://localhost:3000
