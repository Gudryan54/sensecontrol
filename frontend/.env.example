# ============================================================
# Frontend - variáveis de ambiente (exemplo)
# ============================================================
# Copie para ".env" dentro de frontend/ ao rodar o dashboard localmente.
# Variáveis do Vite precisam começar com "VITE_" para ficarem
# disponíveis no navegador (import.meta.env) - é o próprio Vite que
# impõe essa regra, para não expor por engano variáveis de servidor.

# URL da API do backend (Etapa 2/3).
VITE_API_URL=http://localhost:3000

# ID do usuário exibido no dashboard, enquanto não há autenticação
# (Etapa 7). O usuário de demonstração do seed (database/009_demo_data.sql)
# tem id 1.
VITE_USUARIO_ID_DEMO=1
